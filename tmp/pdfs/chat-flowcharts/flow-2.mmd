flowchart TB
    startPoint(["Start"])

    requestBody["Request body
    organizationId + employeeId + userId + sessionId
    New request: prompt + threadId when continuing
    Resume: threadId + reviewId / proposalId + decisions"]

    api["API service
    Parse request
    Check thread organization and session scope
    Load matching checkpoint
    New session: isolate previous history and Semantic context"]

    requestType{"New request ya resume?"}

    startPoint --> requestBody --> api --> requestType

    graphEntry["LangGraph starts
    State: request context + sessionId + threadId
    prompt + current-session history"]

    preparePrompt["Node: preparePromptAndIntent - ONE LLM call
    Input: prompt + current-session context
    Output: polishedPrompt + intent"]

    intentRoute{"Intent?"}

    requestType -->|"New"| graphEntry
    graphEntry --> preparePrompt --> intentRoute

    subgraph memorySearch["Node: loadRelevantMemories - three independent searches"]
        retrieve["Input: organizationId + sessionId + polishedPrompt
        Search Semantic, Procedural and Episodic Memory in parallel"]

        memoryStore[("PostgreSQL Memory Store
        Semantic: organizationId + sessionId
        Procedural and Episodic: organizationId")]

        semanticFound{"Relevant Semantic Memory found?"}
        proceduralFound{"Relevant Procedural Memory found?"}
        episodicFound{"Relevant Episodic Memory found?"}

        semanticUse["semantic = matching facts / preferences
        Only from the current session"]

        proceduralUse["procedural = matching instructions / rules"]

        episodicUse["episodic = matching past episodes
        Advisory steps and outcomes
        Verify against the current request
        Do not restore prior-session Semantic facts"]

        memoryContext["Wait for all three searches
        Save each result list in graph state
        Any combination can contain memories"]

        retrieve -->|"Three independently scoped queries"| memoryStore

        memoryStore -->|"Semantic results"| semanticFound
        memoryStore -->|"Procedural results"| proceduralFound
        memoryStore -->|"Episodic results"| episodicFound

        semanticFound -->|"Yes"| semanticUse
        semanticFound -->|"No: semantic = []"| memoryContext
        semanticUse --> memoryContext

        proceduralFound -->|"Yes"| proceduralUse
        proceduralFound -->|"No: procedural = []"| memoryContext
        proceduralUse --> memoryContext

        episodicFound -->|"Yes"| episodicUse
        episodicFound -->|"No: episodic = []"| memoryContext
        episodicUse --> memoryContext
    end

    intentRoute -->|"Task / question"| retrieve

    registryCatalog["Tool registry
    Authorized tool names + descriptions
    Schemas + effects + registered handlers"]

    selectTools["Node: selectRelevantTools - LLM
    Input: polishedPrompt + authorized tool descriptions
    Output: selected tool names"]

    graphEntry -.->|"Available registered capabilities"| registryCatalog

    memoryContext -->|"Memory remains in graph state"| selectTools
    registryCatalog -->|"Authorized names and descriptions"| selectTools

    subgraph initialPath["Initial planning"]
        resolveSchemas["Registry lookup
        Resolve selected names into actual tool definitions
        Output: name + description + input schema + effect"]

        initialPayload["Assemble initial agent input
        prompt + current-session history
        tools: selected tool definitions
        semantic: current-session facts or empty list
        procedural: matching rules or empty list
        episodic: verified hints or empty list
        results: []
        writeDeclined: false"]

        initialAgent["Node: agentModel - LLM
        Read initial assembled input
        Decide initial answer or first tool calls"]

        resolveSchemas -->|"Actual schemas"| initialPayload
        initialPayload --> initialAgent
    end

    selectTools -->|"Selected tool names"| resolveSchemas

    subgraph resultPath["After tool execution"]
        appendResults["Append actual tool results to graph state
        Each result: id + name + result
        Avoid repeating unchanged completed reads"]

        resultPayload["Assemble agent input with results
        prompt + current-session history
        tools: existing selected tool definitions
        semantic: current-session facts or empty list
        procedural: matching rules or empty list
        episodic: verified hints or empty list
        results: updated actual tool results
        writeDeclined: current value"]

        resultAgent["Node: agentModel - LLM
        Read actual tool results
        Decide final answer or further tool calls
        Treat empty tool results as valid information"]

        appendResults -->|"Rebuild input with updated results"| resultPayload
        resultPayload --> resultAgent
    end

    subgraph declinedPath["After write decline"]
        declined["Set writeDeclined = true
        Keep declined write unexecuted"]

        declinedPayload["Assemble agent input after decline
        prompt + current-session history
        tools: existing selected tool definitions
        semantic: current-session facts or empty list
        procedural: matching rules or empty list
        episodic: verified hints or empty list
        results: previous tool results or empty list
        writeDeclined: true"]

        declinedAgent["Node: agentModel - LLM
        Respect the declined write
        Decide final answer or another permitted action
        Do not re-propose the same declined write"]

        declined --> declinedPayload
        declinedPayload --> declinedAgent
    end

    hasCalls{"Are there tool calls?"}

    initialAgent -->|"Output: response + calls list"| hasCalls
    resultAgent -->|"Output: response + calls list"| hasCalls
    declinedAgent -->|"Output: response + calls list"| hasCalls

    authorize["Node: authorizeToolCalls
    Check selected names, access and input schemas
    Resolve effects using registry metadata"]

    operationType{"Read or write?"}

    executeRead["Node: executeRegisteredTools
    Validate read arguments
    Dispatch registered handlers by name"]

    prepareWrite["Node: prepareWriteProposal
    Fetch write schemas and required inputs
    Gather inputs using registered read tools
    Preview all targets, fields, values and effects
    Validate and freeze every write call"]

    writeReview["Interrupt: await tool-write approval
    proposalId + exact calls + complete previews"]

    executeWrite["Execute frozen approved calls
    Dispatch every approved call
    Use a stable retry key for each batch entry"]

    businessDatabase[("Local PostgreSQL / registered tool backend
    Organization-scoped queries or approved writes")]

    hasCalls -->|"Yes: one or more calls"| authorize
    authorize --> operationType

    operationType -->|"Read"| executeRead
    operationType -->|"Write / mixed calls"| prepareWrite

    executeRead -->|"Arguments + request context"| businessDatabase
    prepareWrite -->|"Complete frozen proposal"| writeReview

    executeWrite -->|"Approved arguments + request context"| businessDatabase
    businessDatabase -->|"Returned rows / write results"| appendResults

    composeResponse["Node: composeTaskResponse
    Use agent response after calls are complete
    Preserve original structured tool results"]

    episode["Node: recordEpisode
    Input: prompt + performed steps + resolved ambiguity + outcome
    LLM summarizes and saves Episodic Memory
    Store request metadata and source sessionId"]

    hasCalls -->|"No: calls = []"| composeResponse
    composeResponse --> episode

    subgraph semanticSave["Semantic Memory addition"]
        semanticPolish["Node: polishSemanticBatch
        Prepare all facts together
        Assign stable candidateIds and item versions
        Edits: reprocess affected facts
        Preserve unchanged decisions"]

        semanticScope["Node: checkSemanticToolScope
        Check implied operations against registered tools
        Identify limitations and eligible preferences"]

        semanticSearch["Node: searchSimilarSemanticBatch
        Search all pending facts together
        Scope: organizationId + sessionId
        Return matching memoryIds per candidateId or empty lists"]

        semanticStage["Node: buildSemanticReviewList
        Combine proposed facts and existing matches
        candidateId + exact proposed text + matching memoryIds
        Exact create/update choices + item versions
        Include limitations and eligible preference options"]

        semanticReview["Interrupt: Semantic Memory review
        Show the complete combined list
        Per candidateId:
        Add new / Update selected memoryIds / Skip
        Or edit the proposed text"]

        semanticValidate["Node: validateSemanticDecisions
        Validate reviewId, IDs, versions, text and targets
        Collect decisions for the entire batch
        Retain unchanged approvals and skips"]

        semanticReady{"Review batch ready?"}

        subgraph semanticApply["Node: applyApprovedSemanticBatch - internal processing"]
            semanticAction{"Action for next decided candidateId?"}

            semanticAdd["Add new Semantic Memory
            Exact approved text + stable retry key
            Scope: organizationId + sessionId"]

            semanticUpdate["Update existing Semantic Memory
            Only selected memoryIds in the same scope
            Use the exact approved text"]

            semanticSkip["Skip candidate
            No memory write"]

            semanticCollect["Collect per-ID outcome
            candidateId + action + status + memoryIds"]

            moreDecisions{"More IDs in the approved batch?"}

            semanticAction -->|"Add new"| semanticAdd
            semanticAction -->|"Update existing"| semanticUpdate
            semanticAction -->|"Skip"| semanticSkip

            semanticAdd --> semanticCollect
            semanticUpdate --> semanticCollect
            semanticSkip --> semanticCollect

            semanticCollect --> moreDecisions
            moreDecisions -->|"Yes: next submitted decision"| semanticAction
        end

        semanticOutcome["Node: composeSemanticOutcome
        Summarize saved, updated, skipped or failed items
        Return outcomes for every candidateId"]

        semanticPolish --> semanticScope
        semanticScope --> semanticSearch
        semanticSearch --> semanticStage
        semanticStage --> semanticReview

        semanticValidate --> semanticReady

        semanticReady -->|"Edited text: affected facts only"| semanticPolish
        semanticReady -->|"Missing decisions: remaining IDs"| semanticReview
        semanticReady -->|"All IDs decided"| semanticAction

        moreDecisions -->|"No"| semanticOutcome
    end

    intentRoute -->|"Save Semantic Memory"| semanticPolish

    proceduralGuide["Response: use /memory API
    Submit all Procedural rules as one batch
    Review all rule IDs together: approve / deny / edit"]

    intentRoute -->|"Save Procedural Memory"| proceduralGuide

    pending["Pending result
    status: approval_required
    sessionId + threadId + review
    reviewId / proposalId
    Semantic review includes the combined candidate list
    Graph remains paused"]

    writeReview --> pending
    semanticReview --> pending

    resumePoint(["Resume LangGraph from saved checkpoint
    Same organizationId + sessionId + threadId"])

    reviewKind{"Which review is pending?"}

    writeDecision{"Tool-write decision?"}

    requestType -->|"Resume"| resumePoint
    resumePoint --> reviewKind

    reviewKind -->|"Tool-write review"| writeDecision
    reviewKind -->|"Semantic batch review"| semanticValidate

    writeDecision -->|"Approve matching proposalId"| executeWrite
    writeDecision -->|"Decline"| declined

    checkpoints[("Postgres Checkpointer
    Automatic persistence after graph supersteps
    Request IDs + sessionId + threadId + session history
    Candidate batch + matches + versions + decisions
    Tool results + pending review + frozen proposal")]

    graphEntry -.->|"Checkpointing covers graph execution"| checkpoints
    checkpoints -.->|"Restore matching session and thread state"| resumePoint

    completed["Completed result
    status: completed
    sessionId + threadId + response
    Structured tool results or per-ID memory outcomes"]

    episode --> completed
    semanticOutcome --> completed
    proceduralGuide --> completed

    apiResponse["API response
    HTTP 200: completed result
    HTTP 202: pending review"]

    endPoint(["End - current HTTP request"])

    completed --> apiResponse
    pending --> apiResponse
    apiResponse --> endPoint

    classDef green fill:#163e2b,stroke:#31c46c,color:#ffffff
    classDef red fill:#512424,stroke:#ef5350,color:#ffffff
    classDef llm fill:#34254f,stroke:#ab86e8,color:#ffffff
    classDef highlighted fill:#fff3bf,stroke:#d69e00,color:#332600,stroke-width:3px
    classDef execution fill:#ffdfba,stroke:#d97706,color:#442000,stroke-width:3px

    class startPoint,resumePoint green
    class writeReview,semanticReview,endPoint red
    class preparePrompt,selectTools,initialAgent,resultAgent,declinedAgent llm

class requestBody,api,requestType,graphEntry,preparePrompt,intentRoute,retrieve,memoryStore,semanticFound,proceduralFound,episodicFound,proceduralUse,memoryContext,registryCatalog,selectTools,resolveSchemas,initialPayload,initialAgent,hasCalls,composeResponse,episode,completed,apiResponse,checkpoints,authorize,operationType,businessDatabase,appendResults,resultPayload,resultAgent highlighted
class executeRead execution
